PORT=3000
DATABASE_URL="file:./dev.db"
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto"
# Registro abierto por defecto. Con "false" solo se permite registrar el primer usuario (app personal).
ALLOW_REGISTRATION=true
NODE_ENV=development
# Dirección de la web (para los enlaces de los correos). En desarrollo, el puerto de Vite.
APP_URL=http://localhost:5173

# Recuperar contraseña por email (opcional) con Gmail: activa la verificación en 2 pasos y crea una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords (16 letras; no es tu contraseña).
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=

# Google Calendar (opcional). Crea un "ID de cliente OAuth" de tipo "Aplicación web" en Google Cloud Console,
# activa la Google Calendar API y añade la URI de redirección exacta (pasa por el proxy de Vite).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
